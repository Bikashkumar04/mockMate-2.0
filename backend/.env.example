# Copy this file to .env and fill in your values. Never commit .env to git.

# Sarvam AI API Key
SARVAM_API_KEY=your-sarvam-api-key-here

# Sarvam AI Models & Endpoints
SARVAM_LLM_MODEL=sarvam-m
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_STT_ENDPOINT=https://api.sarvam.ai/speech-to-text
SARVAM_TTS_ENDPOINT=https://api.sarvam.ai/text-to-speech
SARVAM_VISION_ENDPOINT=https://api.sarvam.ai/vision
SARVAM_IMAGE_GEN_ENDPOINT=https://api.sarvam.ai/image-generation

# Optional feature toggles
# Set to "disabled" when your API key does not have access.
POSTURE_MODEL=disabled
IMAGEN_MODEL=disabled

# Websearch (Google Custom Search JSON API)
# Optional. When disabled or misconfigured, the app continues without web context.
WEBSEARCH_ENABLED=false
WEBSEARCH_PROVIDER=google_cse
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
WEBSEARCH_MAX_RESULTS=3
WEBSEARCH_TIMEOUT_S=5

# LlamaParse
LLAMA_CLOUD_API_KEY=your-llamaparse-api-key-here
LLAMA_CLOUD_BASE_URL=https://api.cloud.llamaindex.ai

# MongoDB
MONGODB_URI=mongodb://localhost:27017/mockmate
MONGODB_DATABASE=mockmate
MONGODB_USER_COLLECTION=users
MONGODB_RESUME_COLLECTION=resumes
MONGODB_SESSION_COLLECTION=sessions
MONGODB_TRANSCRIPT_COLLECTION=transcripts
MONGODB_POSTURE_COLLECTION=posture_scores
MONGODB_FEEDBACK_COLLECTION=feedback
MONGODB_ASSET_COLLECTION=assets
MONGODB_PERFORMANCE_CARD_COLLECTION=performance_cards

# Application
APP_ENV=development
PORT=8080
LOG_LEVEL=INFO

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,https://www.your-production-domain.com
