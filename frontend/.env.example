# Copy this file to .env.local and fill in your values. Never commit .env.local.

# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Auth Base URL (for Better Auth client - must be NEXT_PUBLIC_)
NEXT_PUBLIC_AUTH_URL=http://localhost:3000

# Better auth configuration (server-side)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=<better-auth-secret>
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>

# MongoDB
MONGODB_URI=<mongodb-uri>
MONGODB_DATABASE=<mongodb-database>

# Polar
POLAR_ACCESS_TOKEN=<polar-access-token>
POLAR_SUCCESS_URL=<polar-success-url>
